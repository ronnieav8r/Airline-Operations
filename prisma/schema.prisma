generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SeatRole {
  CPT
  FO
  FA
  CA
}

enum FlightStatus {
  SCHEDULED
  ENROUTE
  COMPLETE
  CANCELLED
  DELAYED
}

enum FlightLegStatus {
  DRAFT
  SCHEDULED
  READY_FOR_RELEASE
  RELEASED
  ENROUTE
  COMPLETE
  CANCELLED
  DELAYED
}

enum AssignmentStatus {
  PLANNED
  ACTIVE
  RELIEVED
  CANCELLED
}

enum AircraftType {
  CL_65
  EMB_135_145
}

enum AircraftStatus {
  AVAILABLE
  IN_MAINTENANCE
  RESERVED
  IN_FLIGHT
  OUT_OF_SERVICE
}

enum AircraftConfigurationStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  RETIRED
}

enum AircraftCapabilityStatus {
  ACTIVE
  INACTIVE
}

enum DiscrepancyStatus {
  OPEN
  DEFERRED
  CLEARED
  CANCELLED
}

enum DeferralStatus {
  ACTIVE
  CLEARED
  EXPIRED
  CANCELLED
}

enum MaintenanceEventType {
  INSPECTION
  SCHEDULED_MAINTENANCE
  UNSCHEDULED_MAINTENANCE
  REPAIR
  RETURN_TO_SERVICE
  OTHER
}

enum MaintenanceEventStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AirworthinessReleaseStatus {
  DRAFT
  RELEASED
  VOIDED
  SUPERSEDED
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum DutyStatus {
  ON_DUTY
  RESERVE
  OFF_DUTY
  VACATION
  SICK
  TRAINING
  DEADHEADING
}

enum AlertType {
  CREW_SHORTAGE
  MAINTENANCE
  WEATHER
  SCHEDULE_CONFLICT
  DUTY_VIOLATION
  GENERAL
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

enum TimeOffRequestType {
  VACATION
  SICK
  PERSONAL
  TRAINING
  OTHER
}

enum TimeOffRequestStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

enum IdDocumentType {
  PASSPORT
  DRIVERS_LICENSE
  STATE_ID
  MILITARY_ID
  OTHER
}

enum UserRole {
  ADMIN
  OPS
  CREW
}

enum OperatingPart {
  PART_91
  PART_91K
  PART_135
}

enum AuthorityStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  RETIRED
}

enum ReleaseStatus {
  PLANNED
  RELEASED
  CANCELLED
  VOIDED
}

enum ManifestStatus {
  DRAFT
  READY
  LOCKED
  AMENDED
  VOIDED
}

enum WeightBalanceStatus {
  DRAFT
  CALCULATED
  APPROVED
  VOIDED
}

enum FlightLocatingStatus {
  NOT_STARTED
  FILED
  ACTIVE
  CLOSED
  OVERDUE
}

enum DispatchPackageStatus {
  DRAFT
  READY
  REVIEWED
  VOIDED
}

enum ReleaseAuthorityClass {
  PART_91_BASELINE
  PART_91K_FRACTIONAL
  PART_135_ON_DEMAND
}

enum ReleaseRuleSeverity {
  BLOCK
  WARN
  INFO
}

enum ReleaseSnapshotStatus {
  PASS
  BLOCKED
  WARNING_ONLY
}

enum ReleaseFindingStatus {
  PASS
  FAIL
  WARNING
  OVERRIDDEN
  NOT_APPLICABLE
}

enum ReleaseOverrideDecision {
  APPROVED
  DENIED
  VOIDED
  SUPERSEDED
}

enum ReleaseAuditEventType {
  READINESS_EVALUATED
  BLOCKER_FOUND
  OVERRIDE_APPROVED
  OVERRIDE_VOIDED
  RELEASE_BLOCKED
  RELEASE_COMPLETED
  RELEASE_CANCELLED
  RELEASE_VOIDED
}

model Operator {
  id                    String                     @id @default(cuid())
  name                  String
  code                  String                     @unique
  isActive              Boolean                    @default(true)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  operatingAuthorities  OperatingAuthority[]
  controlRecords        OperationalControlRecord[]
  tripOrMissions        TripOrMission[]
  flightLegs            FlightLeg[]
  releasePolicyProfiles ReleasePolicyProfile[]
}

model OperatingAuthority {
  id                    String                     @id @default(cuid())
  operatorId            String
  operatingPart         OperatingPart
  displayName           String
  status                AuthorityStatus            @default(DRAFT)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  operator              Operator                   @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  revisions             AuthorityRevision[]
  manuals               Manual[]
  controlRecords        OperationalControlRecord[]
  flightLegs            FlightLeg[]
  releasePolicyProfiles ReleasePolicyProfile[]

  @@unique([operatorId, operatingPart])
  @@index([operatorId, status])
}

model AuthorityRevision {
  id                   String                     @id @default(cuid())
  operatingAuthorityId String
  revisionLabel        String
  effectiveStart       DateTime
  effectiveEnd         DateTime?
  status               AuthorityStatus            @default(DRAFT)
  notes                String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  operatingAuthority   OperatingAuthority         @relation(fields: [operatingAuthorityId], references: [id], onDelete: Restrict)
  controlRecords       OperationalControlRecord[]
  flightLegs           FlightLeg[]

  @@unique([operatingAuthorityId, revisionLabel])
  @@index([operatingAuthorityId, status])
}

model Manual {
  id                   String             @id @default(cuid())
  operatingAuthorityId String
  name                 String
  documentIdentifier   String?
  publishedAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  operatingAuthority   OperatingAuthority @relation(fields: [operatingAuthorityId], references: [id], onDelete: Restrict)
  revisions            ManualRevision[]

  @@unique([operatingAuthorityId, name])
}

model ManualRevision {
  id             String    @id @default(cuid())
  manualId       String
  revisionLabel  String
  revisionDate   DateTime
  effectiveStart DateTime?
  effectiveEnd   DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  manual         Manual    @relation(fields: [manualId], references: [id], onDelete: Cascade)

  @@unique([manualId, revisionLabel])
  @@index([manualId, effectiveStart])
}

model OperationalControlRecord {
  id                   String             @id @default(cuid())
  flightId             String?            @unique
  flightLegId          String?            @unique
  operatorId           String
  operatingAuthorityId String
  authorityRevisionId  String
  controllingEntity    String
  controlNotes         String?
  createdById          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  flight               Flight?            @relation(fields: [flightId], references: [id], onDelete: SetNull)
  flightLeg            FlightLeg?         @relation(fields: [flightLegId], references: [id], onDelete: SetNull)
  operator             Operator           @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  operatingAuthority   OperatingAuthority @relation(fields: [operatingAuthorityId], references: [id], onDelete: Restrict)
  authorityRevision    AuthorityRevision  @relation(fields: [authorityRevisionId], references: [id], onDelete: Restrict)
  createdBy            User?              @relation("OperationalControlRecordCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  release              FlightRelease?

  @@index([operatorId])
  @@index([operatingAuthorityId])
  @@index([authorityRevisionId])
}

model FlightRelease {
  id                         String                     @id @default(cuid())
  operationalControlRecordId String                     @unique
  status                     ReleaseStatus              @default(PLANNED)
  releasedById               String?
  releasedAt                 DateTime?
  releaseNotes               String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  operationalControlRecord   OperationalControlRecord   @relation(fields: [operationalControlRecordId], references: [id], onDelete: Restrict)
  releasedBy                 User?                      @relation("FlightReleaseReleasedBy", fields: [releasedById], references: [id], onDelete: SetNull)
  readinessSnapshots         ReleaseReadinessSnapshot[]
  releaseOverrides           ReleaseOverride[]
  releaseAuditEvents         ReleaseAuditEvent[]

  @@index([operationalControlRecordId])
  @@index([status])
}

model User {
  id                          String                     @id @default(cuid())
  email                       String                     @unique
  role                        UserRole
  isActive                    Boolean                    @default(true)
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  profile                     UserProfile?
  crewMember                  CrewMember?
  assignedCrewAssignments     AircraftCrewAssignment[]   @relation("AssignmentAuthor")
  timeOffRequestsSubmitted    TimeOffRequest[]           @relation("TimeOffRequestedBy")
  timeOffRequestsReviewed     TimeOffRequest[]           @relation("TimeOffReviewedBy")
  alertsCreated               Alert[]                    @relation("AlertCreatedBy")
  alertsAcknowledged          Alert[]                    @relation("AlertAcknowledgedBy")
  alertsResolved              Alert[]                    @relation("AlertResolvedBy")
  operationalControlRecords   OperationalControlRecord[] @relation("OperationalControlRecordCreatedBy")
  flightReleases              FlightRelease[]            @relation("FlightReleaseReleasedBy")
  assignedAircraftAssignments AircraftAssignment[]       @relation("AircraftAssignmentAssignedBy")
  assignedCrewLegAssignments  CrewLegAssignment[]        @relation("CrewLegAssignmentAssignedBy")
  lockedManifests             Manifest[]                 @relation("ManifestLockedBy")
  calculatedWeightBalanceRuns WeightBalanceRun[]         @relation("WeightBalanceCalculatedBy")
  approvedWeightBalanceRuns   WeightBalanceRun[]         @relation("WeightBalanceApprovedBy")
  dispatchPackagesCreated     DispatchPackage[]          @relation("DispatchPackageCreatedBy")
  dispatchPackagesReviewed    DispatchPackage[]          @relation("DispatchPackageReviewedBy")
  reportedDiscrepancies       Discrepancy[]              @relation("DiscrepancyReportedBy")
  authorizedDeferrals         Deferral[]                 @relation("DeferralAuthorizedBy")
  approvedMaintenanceEvents   MaintenanceEvent[]         @relation("MaintenanceEventApprovedBy")
  airworthinessReleases       AirworthinessRelease[]     @relation("AirworthinessReleaseReleasedBy")
  evaluatedReleaseSnapshots   ReleaseReadinessSnapshot[] @relation("ReleaseReadinessSnapshotEvaluatedBy")
  authoredReleaseOverrides    ReleaseOverride[]          @relation("ReleaseOverrideActor")
  approvedReleaseOverrides    ReleaseOverride[]          @relation("ReleaseOverrideApprover")
  releaseAuditEvents          ReleaseAuditEvent[]        @relation("ReleaseAuditEventActor")
}

model UserProfile {
  id                    String          @id @default(cuid())
  userId                String          @unique
  firstName             String
  lastName              String
  phone                 String?
  dateOfBirth           DateTime?
  idDocumentType        IdDocumentType?
  idDocumentNumber      String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Station {
  id                  String         @id @default(cuid())
  code                String         @unique
  name                String
  city                String
  state               String?
  country             String         @default("USA")
  timezone            String
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  aircraft            Aircraft[]
  crewMembers         CrewMember[]
  departures          Flight[]       @relation("FlightDepartureStation")
  arrivals            Flight[]       @relation("FlightArrivalStation")
  flightLegDepartures FlightLeg[]    @relation("FlightLegDepartureStation")
  flightLegArrivals   FlightLeg[]    @relation("FlightLegArrivalStation")
  crewSchedules       CrewSchedule[]
}

model Aircraft {
  id                    String                   @id @default(cuid())
  tailNumber            String                   @unique
  name                  String?
  type                  AircraftType
  status                AircraftStatus           @default(AVAILABLE)
  homeStationId         String?
  seats                 Int?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  homeStation           Station?                 @relation(fields: [homeStationId], references: [id], onDelete: SetNull)
  flights               Flight[]
  crewAssignments       AircraftCrewAssignment[]
  aircraftAssignments   AircraftAssignment[]
  alerts                Alert[]
  configurations        AircraftConfiguration[]
  capabilities          AircraftCapability[]
  discrepancies         Discrepancy[]
  deferrals             Deferral[]
  maintenanceEvents     MaintenanceEvent[]
  airworthinessReleases AirworthinessRelease[]

  @@index([status])
  @@index([type])
  @@index([homeStationId])
}

model AircraftConfiguration {
  id                 String                      @id @default(cuid())
  aircraftId         String
  configurationLabel String
  status             AircraftConfigurationStatus @default(ACTIVE)
  effectiveStart     DateTime                    @default(now())
  effectiveEnd       DateTime?
  passengerSeatCount Int?
  emptyWeight        Decimal?                    @db.Decimal(10, 2)
  emptyWeightCg      String?
  notes              String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  aircraft           Aircraft                    @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@unique([aircraftId, configurationLabel, effectiveStart])
  @@index([aircraftId, status])
  @@index([effectiveStart, effectiveEnd])
}

model AircraftCapability {
  id             String                   @id @default(cuid())
  aircraftId     String
  capabilityCode String
  status         AircraftCapabilityStatus @default(ACTIVE)
  effectiveStart DateTime                 @default(now())
  effectiveEnd   DateTime?
  description    String?
  notes          String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  aircraft       Aircraft                 @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@unique([aircraftId, capabilityCode, effectiveStart])
  @@index([aircraftId, status])
  @@index([capabilityCode])
}

model Flight {
  id                       String                    @id @default(cuid())
  flightNumber             String
  aircraftId               String
  departureStationId       String
  arrivalStationId         String
  scheduledDeparture       DateTime
  scheduledArrival         DateTime
  actualDeparture          DateTime?
  actualArrival            DateTime?
  status                   FlightStatus              @default(SCHEDULED)
  notes                    String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  aircraft                 Aircraft                  @relation(fields: [aircraftId], references: [id], onDelete: Restrict)
  departureStation         Station                   @relation("FlightDepartureStation", fields: [departureStationId], references: [id], onDelete: Restrict)
  arrivalStation           Station                   @relation("FlightArrivalStation", fields: [arrivalStationId], references: [id], onDelete: Restrict)
  crewLogs                 CrewFlightLog[]
  flightPassengers         FlightPassenger[]
  alerts                   Alert[]
  operationalControlRecord OperationalControlRecord?
  flightLeg                FlightLeg?

  @@unique([flightNumber, scheduledDeparture])
  @@index([scheduledDeparture])
  @@index([status, scheduledDeparture])
  @@index([aircraftId, scheduledDeparture])
}

model CrewMember {
  id               String                   @id @default(cuid())
  userId           String?                  @unique
  employeeNumber   String                   @unique
  firstName        String
  lastName         String
  baseStationId    String
  employmentStatus EmploymentStatus         @default(ACTIVE)
  dutyStatus       DutyStatus               @default(OFF_DUTY)
  hireDate         DateTime?
  phone            String?
  email            String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  user             User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  baseStation      Station                  @relation(fields: [baseStationId], references: [id], onDelete: Restrict)
  qualifications   CrewQualification[]
  assignments      AircraftCrewAssignment[]
  schedules        CrewSchedule[]
  flightLogs       CrewFlightLog[]
  legAssignments   CrewLegAssignment[]
  timeOffRequests  TimeOffRequest[]
  alerts           Alert[]

  @@index([baseStationId])
  @@index([employmentStatus])
  @@index([dutyStatus])
}

model CrewQualification {
  id           String       @id @default(cuid())
  crewMemberId String
  aircraftType AircraftType
  seatRole     SeatRole
  issuedAt     DateTime     @default(now())
  expiresAt    DateTime?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  crewMember   CrewMember   @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)

  @@unique([crewMemberId, aircraftType, seatRole])
  @@index([crewMemberId, expiresAt])
  @@index([aircraftType, seatRole])
}

model AircraftCrewAssignment {
  id                 String              @id @default(cuid())
  aircraftId         String
  crewMemberId       String
  seatRole           SeatRole
  startsAt           DateTime
  endsAt             DateTime?
  isActive           Boolean             @default(true)
  assignedById       String?
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  aircraft           Aircraft            @relation(fields: [aircraftId], references: [id], onDelete: Restrict)
  crewMember         CrewMember          @relation(fields: [crewMemberId], references: [id], onDelete: Restrict)
  assignedBy         User?               @relation("AssignmentAuthor", fields: [assignedById], references: [id], onDelete: SetNull)
  crewLegAssignments CrewLegAssignment[]

  @@unique([aircraftId, crewMemberId, seatRole, startsAt])
  @@index([aircraftId, startsAt, endsAt])
  @@index([aircraftId, seatRole, startsAt])
  @@index([crewMemberId, startsAt])
  @@index([isActive])
}

model TripOrMission {
  id             String      @id @default(cuid())
  operatorId     String
  tripNumber     String
  customerName   String?
  missionType    String?
  requestedStart DateTime?
  requestedEnd   DateTime?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  operator       Operator    @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  flightLegs     FlightLeg[]

  @@unique([operatorId, tripNumber])
  @@index([operatorId, requestedStart])
}

model FlightLeg {
  id                       String                    @id @default(cuid())
  legacyFlightId           String?                   @unique
  tripOrMissionId          String?
  operatorId               String
  operatingAuthorityId     String
  authorityRevisionId      String
  legNumber                Int?
  flightNumber             String?
  departureStationId       String
  arrivalStationId         String
  scheduledDeparture       DateTime
  scheduledArrival         DateTime
  actualDeparture          DateTime?
  actualArrival            DateTime?
  status                   FlightLegStatus           @default(SCHEDULED)
  notes                    String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  legacyFlight             Flight?                   @relation(fields: [legacyFlightId], references: [id], onDelete: SetNull)
  tripOrMission            TripOrMission?            @relation(fields: [tripOrMissionId], references: [id], onDelete: SetNull)
  operator                 Operator                  @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  operatingAuthority       OperatingAuthority        @relation(fields: [operatingAuthorityId], references: [id], onDelete: Restrict)
  authorityRevision        AuthorityRevision         @relation(fields: [authorityRevisionId], references: [id], onDelete: Restrict)
  departureStation         Station                   @relation("FlightLegDepartureStation", fields: [departureStationId], references: [id], onDelete: Restrict)
  arrivalStation           Station                   @relation("FlightLegArrivalStation", fields: [arrivalStationId], references: [id], onDelete: Restrict)
  aircraftAssignments      AircraftAssignment[]
  crewAssignments          CrewLegAssignment[]
  operationalControlRecord OperationalControlRecord?
  inboundTurnaroundLinks   TurnaroundLink[]          @relation("TurnaroundInboundLeg")
  outboundTurnaroundLinks  TurnaroundLink[]          @relation("TurnaroundOutboundLeg")
  manifest                 Manifest?
  weightBalanceRuns        WeightBalanceRun[]
  flightLocatingRecord     FlightLocatingRecord?
  dispatchPackage          DispatchPackage?
  airworthinessReleases    AirworthinessRelease[]
  flightPlanReferences     FlightPlanReference[]
  readinessSnapshots       ReleaseReadinessSnapshot[]
  releaseOverrides         ReleaseOverride[]
  releaseAuditEvents       ReleaseAuditEvent[]

  @@index([scheduledDeparture])
  @@index([status, scheduledDeparture])
  @@index([operatorId, scheduledDeparture])
  @@index([operatingAuthorityId, scheduledDeparture])
  @@index([departureStationId, scheduledDeparture])
  @@index([arrivalStationId, scheduledArrival])
}

model Discrepancy {
  id                String             @id @default(cuid())
  aircraftId        String
  reportedById      String?
  discrepancyNumber String
  title             String
  description       String?
  status            DiscrepancyStatus  @default(OPEN)
  severity          String?
  reportedAt        DateTime           @default(now())
  clearedAt         DateTime?
  correctiveSummary String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  aircraft          Aircraft           @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  reportedBy        User?              @relation("DiscrepancyReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)
  deferrals         Deferral[]
  maintenanceEvents MaintenanceEvent[]

  @@unique([aircraftId, discrepancyNumber])
  @@index([aircraftId, status])
  @@index([reportedAt])
  @@index([reportedById])
}

model Deferral {
  id             String         @id @default(cuid())
  aircraftId     String
  discrepancyId  String
  authorizedById String?
  deferralNumber String
  status         DeferralStatus @default(ACTIVE)
  category       String?
  deferredAt     DateTime       @default(now())
  dueAt          DateTime?
  clearedAt      DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  aircraft       Aircraft       @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  discrepancy    Discrepancy    @relation(fields: [discrepancyId], references: [id], onDelete: Cascade)
  authorizedBy   User?          @relation("DeferralAuthorizedBy", fields: [authorizedById], references: [id], onDelete: SetNull)

  @@unique([aircraftId, deferralNumber])
  @@index([aircraftId, status])
  @@index([discrepancyId])
  @@index([dueAt])
  @@index([authorizedById])
}

model MaintenanceEvent {
  id                String                 @id @default(cuid())
  aircraftId        String
  discrepancyId     String?
  approvedById      String?
  maintenanceNumber String
  eventType         MaintenanceEventType
  status            MaintenanceEventStatus @default(PLANNED)
  scheduledAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  providerName      String?
  description       String?
  returnToServiceAt DateTime?
  notes             String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  aircraft          Aircraft               @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  discrepancy       Discrepancy?           @relation(fields: [discrepancyId], references: [id], onDelete: SetNull)
  approvedBy        User?                  @relation("MaintenanceEventApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([aircraftId, maintenanceNumber])
  @@index([aircraftId, status])
  @@index([eventType])
  @@index([scheduledAt])
  @@index([completedAt])
  @@index([discrepancyId])
  @@index([approvedById])
}

model AirworthinessRelease {
  id            String                     @id @default(cuid())
  aircraftId    String
  flightLegId   String?
  releasedById  String?
  releaseNumber String
  status        AirworthinessReleaseStatus @default(DRAFT)
  releasedAt    DateTime?
  expiresAt     DateTime?
  releaseNotes  String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  aircraft      Aircraft                   @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  flightLeg     FlightLeg?                 @relation(fields: [flightLegId], references: [id], onDelete: SetNull)
  releasedBy    User?                      @relation("AirworthinessReleaseReleasedBy", fields: [releasedById], references: [id], onDelete: SetNull)

  @@unique([aircraftId, releaseNumber])
  @@index([aircraftId, status])
  @@index([flightLegId])
  @@index([releasedAt])
  @@index([expiresAt])
  @@index([releasedById])
}

model ReleasePolicyProfile {
  id                   String                     @id @default(cuid())
  profileKey           String                     @unique
  operatorId           String
  operatingAuthorityId String?
  name                 String
  authorityClass       ReleaseAuthorityClass
  isDefault            Boolean                    @default(false)
  effectiveFrom        DateTime                   @default(now())
  effectiveTo          DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  operator             Operator                   @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  operatingAuthority   OperatingAuthority?        @relation(fields: [operatingAuthorityId], references: [id], onDelete: Restrict)
  rules                ReleasePolicyRule[]
  readinessSnapshots   ReleaseReadinessSnapshot[]
  releaseOverrides     ReleaseOverride[]

  @@index([operatorId, isDefault])
  @@index([operatingAuthorityId, isDefault])
  @@index([authorityClass])
  @@index([effectiveFrom, effectiveTo])
}

model ReleasePolicyRule {
  id                       String                     @id @default(cuid())
  profileId                String
  ruleKey                  String
  readinessCategory        String
  severity                 ReleaseRuleSeverity
  isOverridable            Boolean                    @default(false)
  requiresSecondApproval   Boolean                    @default(false)
  manualEvidenceAllowed    Boolean                    @default(false)
  providerEvidenceRequired Boolean                    @default(false)
  effectiveFrom            DateTime                   @default(now())
  effectiveTo              DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  profile                  ReleasePolicyProfile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  readinessFindings        ReleaseReadinessFinding[]

  @@unique([profileId, ruleKey])
  @@index([ruleKey])
  @@index([readinessCategory, severity])
  @@index([effectiveFrom, effectiveTo])
}

model ReleaseReadinessSnapshot {
  id              String                     @id @default(cuid())
  flightLegId     String
  flightReleaseId String
  policyProfileId String
  snapshotStatus  ReleaseSnapshotStatus
  evaluatedAt     DateTime                   @default(now())
  evaluatedById   String?
  authorityClass  ReleaseAuthorityClass
  summary         Json?
  createdAt       DateTime                   @default(now())
  flightLeg       FlightLeg                  @relation(fields: [flightLegId], references: [id], onDelete: Cascade)
  flightRelease   FlightRelease              @relation(fields: [flightReleaseId], references: [id], onDelete: Cascade)
  policyProfile   ReleasePolicyProfile       @relation(fields: [policyProfileId], references: [id], onDelete: Restrict)
  evaluatedBy     User?                      @relation("ReleaseReadinessSnapshotEvaluatedBy", fields: [evaluatedById], references: [id], onDelete: SetNull)
  findings        ReleaseReadinessFinding[]
  auditEvents     ReleaseAuditEvent[]

  @@index([flightLegId, evaluatedAt])
  @@index([flightReleaseId, evaluatedAt])
  @@index([policyProfileId])
  @@index([snapshotStatus])
  @@index([evaluatedById])
}

model ReleaseReadinessFinding {
  id                String                    @id @default(cuid())
  snapshotId        String
  ruleId            String?
  ruleKey           String
  readinessCategory String
  severity          ReleaseRuleSeverity
  status            ReleaseFindingStatus
  isOverridable     Boolean                   @default(false)
  summary           String
  evidenceRefType   String?
  evidenceRefId     String?
  details           Json?
  createdAt         DateTime                  @default(now())
  snapshot          ReleaseReadinessSnapshot  @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  rule              ReleasePolicyRule?        @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  releaseOverrides  ReleaseOverride[]

  @@index([snapshotId, severity])
  @@index([ruleId])
  @@index([ruleKey])
  @@index([readinessCategory, status])
}

model ReleaseOverride {
  id                  String                  @id @default(cuid())
  findingId           String
  flightLegId         String
  flightReleaseId     String
  policyProfileId     String
  decision            ReleaseOverrideDecision @default(APPROVED)
  reason              String
  supportingReference String?
  actorUserId         String?
  actorRole           String?
  approvedById        String?
  approvedRole        String?
  attestationText     String?
  signatureRef        String?
  expiresAt           DateTime?
  createdAt           DateTime                @default(now())
  voidedAt            DateTime?
  voidReason          String?
  finding             ReleaseReadinessFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  flightLeg           FlightLeg               @relation(fields: [flightLegId], references: [id], onDelete: Cascade)
  flightRelease       FlightRelease           @relation(fields: [flightReleaseId], references: [id], onDelete: Cascade)
  policyProfile       ReleasePolicyProfile    @relation(fields: [policyProfileId], references: [id], onDelete: Restrict)
  actorUser           User?                   @relation("ReleaseOverrideActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  approvedBy          User?                   @relation("ReleaseOverrideApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  auditEvents         ReleaseAuditEvent[]

  @@index([findingId])
  @@index([flightLegId, createdAt])
  @@index([flightReleaseId])
  @@index([policyProfileId])
  @@index([decision])
  @@index([actorUserId])
  @@index([approvedById])
}

model ReleaseAuditEvent {
  id              String                @id @default(cuid())
  flightLegId     String
  flightReleaseId String?
  snapshotId      String?
  overrideId      String?
  eventType       ReleaseAuditEventType
  actorUserId     String?
  actorRole       String?
  message         String
  metadata        Json?
  createdAt       DateTime              @default(now())
  flightLeg       FlightLeg             @relation(fields: [flightLegId], references: [id], onDelete: Cascade)
  flightRelease   FlightRelease?        @relation(fields: [flightReleaseId], references: [id], onDelete: SetNull)
  snapshot        ReleaseReadinessSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  override        ReleaseOverride?      @relation(fields: [overrideId], references: [id], onDelete: SetNull)
  actorUser       User?                 @relation("ReleaseAuditEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([flightLegId, createdAt])
  @@index([flightReleaseId])
  @@index([snapshotId])
  @@index([overrideId])
  @@index([eventType])
  @@index([actorUserId])
}

model AircraftAssignment {
  id           String           @id @default(cuid())
  flightLegId  String
  aircraftId   String
  status       AssignmentStatus @default(PLANNED)
  assignedAt   DateTime         @default(now())
  releasedAt   DateTime?
  assignedById String?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  flightLeg    FlightLeg        @relation(fields: [flightLegId], references: [id], onDelete: Cascade)
  aircraft     Aircraft         @relation(fields: [aircraftId], references: [id], onDelete: Restrict)
  assignedBy   User?            @relation("AircraftAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([flightLegId, aircraftId])
  @@index([aircraftId, assignedAt])
  @@index([status])
}

model CrewLegAssignment {
  id                             String                  @id @default(cuid())
  flightLegId                    String
  crewMemberId                   String
  seatRole                       SeatRole
  status                         AssignmentStatus        @default(PLANNED)
  reportTime                     DateTime?
  releaseTime                    DateTime?
  assignedById                   String?
  sourceAircraftCrewAssignmentId String?
  notes                          String?
  createdAt                      DateTime                @default(now())
  updatedAt                      DateTime                @updatedAt
  flightLeg                      FlightLeg               @relation(fields: [flightLegId], references: [id], onDelete: Cascade)
  crewMember                     CrewMember              @relation(fields: [crewMemberId], references: [id], onDelete: Restrict)
  assignedBy                     User?                   @relation("CrewLegAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  sourceAircraftCrewAssignment   AircraftCrewAssignment? @relation(fields: [sourceAircraftCrewAssignmentId], references: [id], onDelete: SetNull)

  @@unique([flightLegId, crewMemberId, seatRole])
  @@index([flightLegId, seatRole])
  @@index([crewMemberId, reportTime])
  @@index([sourceAircraftCrewAssignmentId])
  @@index([status])
}

model TurnaroundLink {
  id                  String    @id @default(cuid())
  inboundFlightLegId  String
  outboundFlightLegId String
  minimumTurnMinutes  Int?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  inboundFlightLeg    FlightLeg @relation("TurnaroundInboundLeg", fields: [inboundFlightLegId], references: [id], onDelete: Cascade)
  outboundFlightLeg   FlightLeg @relation("TurnaroundOutboundLeg", fields: [outboundFlightLegId], references: [id], onDelete: Cascade)

  @@unique([inboundFlightLegId, outboundFlightLegId])
  @@index([outboundFlightLegId])
}

model Manifest {
  id                String             @id @default(cuid())
  flightLegId       String             @unique
  status            ManifestStatus     @default(DRAFT)
  lockedAt          DateTime?
  lockedById        String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  flightLeg         FlightLeg          @relation(fields: [flightLegId], references: [id], onDelete: Cascade)
  lockedBy          User?              @relation("ManifestLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)
  items             ManifestItem[]
  weightBalanceRuns WeightBalanceRun[]

  @@index([status])
  @@index([lockedById])
}

model ManifestItem {
  id            String     @id @default(cuid())
  manifestId    String
  passengerId   String?
  personName    String?
  seatNumber    String?
  weight        Decimal?   @db.Decimal(8, 2)
  baggageWeight Decimal?   @db.Decimal(8, 2)
  checkedInAt   DateTime?
  boardedAt     DateTime?
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  manifest      Manifest   @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  passenger     Passenger? @relation(fields: [passengerId], references: [id], onDelete: SetNull)

  @@index([manifestId])
  @@index([passengerId])
}

model WeightBalanceRun {
  id                  String              @id @default(cuid())
  flightLegId         String
  manifestId          String?
  runLabel            String
  status              WeightBalanceStatus @default(DRAFT)
  takeoffWeight       Decimal?            @db.Decimal(10, 2)
  landingWeight       Decimal?            @db.Decimal(10, 2)
  centerOfGravity     String?
  calculatedById      String?
  calculatedAt        DateTime?
  approvedById        String?
  approvedAt          DateTime?
  calculationSnapshot Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  flightLeg           FlightLeg           @relation(fields: [flightLegId], references: [id], onDelete: Cascade)
  manifest            Manifest?           @relation(fields: [manifestId], references: [id], onDelete: SetNull)
  calculatedBy        User?               @relation("WeightBalanceCalculatedBy", fields: [calculatedById], references: [id], onDelete: SetNull)
  approvedBy          User?               @relation("WeightBalanceApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([flightLegId, runLabel])
  @@index([flightLegId, status])
  @@index([manifestId])
  @@index([calculatedById])
  @@index([approvedById])
}

model FlightLocatingRecord {
  id                String               @id @default(cuid())
  flightLegId       String               @unique
  status            FlightLocatingStatus @default(NOT_STARTED)
  responsibleParty  String?
  plannedRoute      String?
  lastKnownPosition String?
  activatedAt       DateTime?
  closedAt          DateTime?
  overdueAt         DateTime?
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  flightLeg         FlightLeg            @relation(fields: [flightLegId], references: [id], onDelete: Cascade)
  positionReports   PositionReport[]

  @@index([status])
}

model PositionReport {
  id                     String               @id @default(cuid())
  flightLocatingRecordId String
  reportedAt             DateTime
  positionSummary        String
  latitude               Decimal?             @db.Decimal(9, 6)
  longitude              Decimal?             @db.Decimal(9, 6)
  altitude               Int?
  groundspeed            Int?
  heading                Int?
  source                 String               @default("MANUAL")
  notes                  String?
  createdAt              DateTime             @default(now())
  flightLocatingRecord   FlightLocatingRecord @relation(fields: [flightLocatingRecordId], references: [id], onDelete: Cascade)

  @@index([flightLocatingRecordId, reportedAt])
  @@index([source])
}

model WeatherBriefingSnapshot {
  id               String            @id @default(cuid())
  snapshotKey      String            @unique
  provider         String?
  briefingAt       DateTime
  routeSummary     String?
  rawSnapshot      Json?
  createdAt        DateTime          @default(now())
  dispatchPackages DispatchPackage[]
}

model NotamSnapshot {
  id                   String            @id @default(cuid())
  snapshotKey          String            @unique
  capturedAt           DateTime
  affectedStationCodes String?
  rawSnapshot          Json?
  createdAt            DateTime          @default(now())
  dispatchPackages     DispatchPackage[]
}

model FlightPlanReference {
  id                String            @id @default(cuid())
  flightLegId       String
  provider          String?
  externalReference String?
  filedAt           DateTime?
  status            String?
  routeText         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  flightLeg         FlightLeg         @relation(fields: [flightLegId], references: [id], onDelete: Cascade)
  dispatchPackages  DispatchPackage[]

  @@unique([flightLegId, externalReference])
  @@index([flightLegId])
  @@index([status])
}

model DispatchPackage {
  id                    String                   @id @default(cuid())
  flightLegId           String                   @unique
  weatherBriefingId     String?
  notamSnapshotId       String?
  flightPlanReferenceId String?
  performanceData       Json?
  status                DispatchPackageStatus    @default(DRAFT)
  readyAt               DateTime?
  reviewedAt            DateTime?
  reviewedById          String?
  voidedAt              DateTime?
  reviewNotes           String?
  createdById           String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  flightLeg             FlightLeg                @relation(fields: [flightLegId], references: [id], onDelete: Cascade)
  weatherBriefing       WeatherBriefingSnapshot? @relation(fields: [weatherBriefingId], references: [id], onDelete: SetNull)
  notamSnapshot         NotamSnapshot?           @relation(fields: [notamSnapshotId], references: [id], onDelete: SetNull)
  flightPlanReference   FlightPlanReference?     @relation(fields: [flightPlanReferenceId], references: [id], onDelete: SetNull)
  createdBy             User?                    @relation("DispatchPackageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy            User?                    @relation("DispatchPackageReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([weatherBriefingId])
  @@index([notamSnapshotId])
  @@index([flightPlanReferenceId])
  @@index([createdById])
  @@index([reviewedById])
}

model CrewSchedule {
  id           String     @id @default(cuid())
  crewMemberId String
  stationId    String?
  date         DateTime
  dutyStatus   DutyStatus
  startsAt     DateTime?
  endsAt       DateTime?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  crewMember   CrewMember @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)
  station      Station?   @relation(fields: [stationId], references: [id], onDelete: SetNull)

  @@index([crewMemberId, date])
  @@index([date])
}

model CrewFlightLog {
  id           String     @id @default(cuid())
  crewMemberId String
  flightId     String
  seatRole     SeatRole
  reportTime   DateTime?
  releaseTime  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  crewMember   CrewMember @relation(fields: [crewMemberId], references: [id], onDelete: Restrict)
  flight       Flight     @relation(fields: [flightId], references: [id], onDelete: Restrict)

  @@unique([crewMemberId, flightId, seatRole])
  @@index([flightId])
}

model Passenger {
  id               String            @id @default(cuid())
  firstName        String
  lastName         String
  dateOfBirth      DateTime?
  email            String?
  phone            String?
  idDocumentType   IdDocumentType?
  idDocumentNumber String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  flights          FlightPassenger[]
  manifestItems    ManifestItem[]

  @@index([lastName, firstName])
}

model FlightPassenger {
  id          String    @id @default(cuid())
  flightId    String
  passengerId String
  seatNumber  String?
  checkedInAt DateTime?
  boardedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  flight      Flight    @relation(fields: [flightId], references: [id], onDelete: Cascade)
  passenger   Passenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)

  @@unique([flightId, passengerId])
  @@index([flightId, seatNumber])
}

model TimeOffRequest {
  id            String               @id @default(cuid())
  crewMemberId  String
  requestType   TimeOffRequestType
  status        TimeOffRequestStatus @default(PENDING)
  startDate     DateTime
  endDate       DateTime
  reason        String?
  requestedById String?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  crewMember    CrewMember           @relation(fields: [crewMemberId], references: [id], onDelete: Restrict)
  requestedBy   User?                @relation("TimeOffRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedBy    User?                @relation("TimeOffReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([crewMemberId, startDate])
  @@index([status, createdAt])
}

model Alert {
  id               String        @id @default(cuid())
  type             AlertType
  severity         AlertSeverity @default(MEDIUM)
  status           AlertStatus   @default(ACTIVE)
  title            String
  message          String
  flightId         String?
  aircraftId       String?
  crewMemberId     String?
  createdById      String?
  acknowledgedById String?
  resolvedById     String?
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  flight           Flight?       @relation(fields: [flightId], references: [id], onDelete: SetNull)
  aircraft         Aircraft?     @relation(fields: [aircraftId], references: [id], onDelete: SetNull)
  crewMember       CrewMember?   @relation(fields: [crewMemberId], references: [id], onDelete: SetNull)
  createdBy        User?         @relation("AlertCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  acknowledgedBy   User?         @relation("AlertAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  resolvedBy       User?         @relation("AlertResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, type, createdAt])
  @@index([createdAt])
}

model DutyRule {
  id                   String   @id @default(cuid())
  name                 String   @unique
  description          String?
  maxDutyHours         Int?
  minRestHours         Int?
  maxFlightHoursPerDay Int?
  maxConsecutiveDays   Int?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([isActive])
}
