  updatedAt   DateTime  @updatedAt
  flight      Flight    @relation(fields: [flightId], references: [id], onDelete: Cascade)
  passenger   Passenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)

  @@unique([flightId, passengerId])
  @@index([flightId, seatNumber])
}

model TimeOffRequest {
  id            String               @id @default(cuid())
  crewMemberId  String
  requestType   TimeOffRequestType
  status        TimeOffRequestStatus @default(PENDING)
  startDate     DateTime
  endDate       DateTime
  reason        String?
  requestedById String?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  crewMember    CrewMember           @relation(fields: [crewMemberId], references: [id], onDelete: Restrict)
  requestedBy   User?                @relation("TimeOffRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedBy    User?                @relation("TimeOffReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([crewMemberId, startDate])
  @@index([status, createdAt])
}

model Alert {
  id               String        @id @default(cuid())
  type             AlertType
  severity         AlertSeverity @default(MEDIUM)
  status           AlertStatus   @default(ACTIVE)
  title            String
  message          String
  flightId         String?
  aircraftId       String?
  crewMemberId     String?
  createdById      String?
  acknowledgedById String?
  resolvedById     String?
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  flight           Flight?       @relation(fields: [flightId], references: [id], onDelete: SetNull)
  aircraft         Aircraft?     @relation(fields: [aircraftId], references: [id], onDelete: SetNull)
  crewMember       CrewMember?   @relation(fields: [crewMemberId], references: [id], onDelete: SetNull)
  createdBy        User?         @relation("AlertCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  acknowledgedBy   User?         @relation("AlertAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  resolvedBy       User?         @relation("AlertResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, type, createdAt])
  @@index([createdAt])
}

model DutyRule {
  id                   String   @id @default(cuid())
  name                 String   @unique
  description          String?
  maxDutyHours         Int?
  minRestHours         Int?
  maxFlightHoursPerDay Int?
  maxConsecutiveDays   Int?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([isActive])
}

model DutyRestPolicyProfile {
  id                                 String                   @id @default(cuid())
  profileKey                         String                   @unique
  operatorId                         String
  operatingAuthorityId               String?
  authorityRevisionId                String?
  name                               String
  operationKind                      DutyRestOperationKind
  calculationBasis                   DutyRestCalculationBasis @default(UTC)
  enforcementMode                    DutyRestEnforcementMode  @default(WARNING_ONLY)
  ordinaryPart91PolicyEnabled        Boolean                  @default(false)
  outsideCommercialFlyingRequired    Boolean                  @default(false)
  reserveCountsAsRest                Boolean                  @default(false)
  standbyCountsAsDuty                Boolean                  @default(true)
  requiredTransportationCountsAsRest Boolean                  @default(false)
  reducedRestRequiresReview          Boolean                  @default(true)
  isDefault                          Boolean                  @default(false)
  effectiveFrom                      DateTime                 @default(now())
  effectiveTo                        DateTime?
  sourceSummary                      String?
  notes                              String?
  createdAt                          DateTime                 @default(now())
  updatedAt                          DateTime                 @updatedAt
  operator                           Operator                 @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  operatingAuthority                 OperatingAuthority?      @relation(fields: [operatingAuthorityId], references: [id], onDelete: Restrict)
  authorityRevision                  AuthorityRevision?       @relation(fields: [authorityRevisionId], references: [id], onDelete: SetNull)
  ruleSettings                       DutyRestRuleSetting[]

  @@index([operatorId, isDefault])
  @@index([operatingAuthorityId, isDefault])
  @@index([authorityRevisionId])
  @@index([operationKind])
  @@index([effectiveFrom, effectiveTo])
}

model DutyRestRuleSetting {
  id                     String                @id @default(cuid())
  profileId              String
  ruleKey                String
  title                  String
  regulationPart         String
  crewRoleScope          String
  triggerCondition       String?
  requiredInputs         Json?
  calculationNotes       String?
  passCondition          String?
  warningMessage         String
  severity               DutyRestRuleSeverity  @default(WARN)
  enabled                Boolean               @default(true)
  requiresExternalFlying Boolean               @default(false)
  requiresOperatorReview Boolean               @default(true)
  implementationPhase    Int                   @default(1)
  sourceCitation         String
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  profile                DutyRestPolicyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, ruleKey])
  @@index([ruleKey])
  @@index([regulationPart])
  @@index([enabled, severity])
  @@index([requiresOperatorReview])
}
