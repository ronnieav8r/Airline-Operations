model Operator {
  id                     String                     @id @default(cuid())
  name                   String
  code                   String                     @unique
  isActive               Boolean                    @default(true)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  operatingAuthorities   OperatingAuthority[]
  controlRecords         OperationalControlRecord[]
  customers              Customer[]
  tripOrMissions         TripOrMission[]
  flightLegs             FlightLeg[]
  releasePolicyProfiles  ReleasePolicyProfile[]
  dutyRestPolicyProfiles DutyRestPolicyProfile[]
  fuelSetting            OperatorFuelSetting?
  releaseSetting         OperatorReleaseSetting?
}

model OperatingAuthority {
  id                     String                     @id @default(cuid())
  operatorId             String
  operatingPart          OperatingPart
  displayName            String
  status                 AuthorityStatus            @default(DRAFT)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  operator               Operator                   @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  revisions              AuthorityRevision[]
  manuals                Manual[]
  controlRecords         OperationalControlRecord[]
  flightLegs             FlightLeg[]
  releasePolicyProfiles  ReleasePolicyProfile[]
  dutyRestPolicyProfiles DutyRestPolicyProfile[]

  @@unique([operatorId, operatingPart])
  @@index([operatorId, status])
}

model AuthorityRevision {
  id                     String                     @id @default(cuid())
  operatingAuthorityId   String
  revisionLabel          String
  effectiveStart         DateTime
  effectiveEnd           DateTime?
  status                 AuthorityStatus            @default(DRAFT)
  notes                  String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  operatingAuthority     OperatingAuthority         @relation(fields: [operatingAuthorityId], references: [id], onDelete: Restrict)
  controlRecords         OperationalControlRecord[]
  flightLegs             FlightLeg[]
  dutyRestPolicyProfiles DutyRestPolicyProfile[]

  @@unique([operatingAuthorityId, revisionLabel])
  @@index([operatingAuthorityId, status])
}

model Customer {
  id                        String                     @id @default(cuid())
  operatorId                String
  name                      String
  customerCode              String?
  contactName               String?
  contactEmail              String?
  contactPhone              String?
  notes                     String?
  isActive                  Boolean                    @default(true)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  operator                  Operator                   @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  operationalControlRecords OperationalControlRecord[]

  @@unique([operatorId, name])
  @@index([operatorId, isActive])
}

model Manual {
  id                   String             @id @default(cuid())
  operatingAuthorityId String
  name                 String
  documentIdentifier   String?
  publishedAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  operatingAuthority   OperatingAuthority @relation(fields: [operatingAuthorityId], references: [id], onDelete: Restrict)
  revisions            ManualRevision[]

  @@unique([operatingAuthorityId, name])
}

model ManualRevision {
  id             String    @id @default(cuid())
  manualId       String
  revisionLabel  String
  revisionDate   DateTime
  effectiveStart DateTime?
  effectiveEnd   DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  manual         Manual    @relation(fields: [manualId], references: [id], onDelete: Cascade)

  @@unique([manualId, revisionLabel])
  @@index([manualId, effectiveStart])
}

model OperationalControlRecord {
  id                   String             @id @default(cuid())
  flightId             String?            @unique
  flightLegId          String?            @unique
  operatorId           String
  operatingAuthorityId String
  authorityRevisionId  String
  customerId           String?
  controllingEntity    String
  controlNotes         String?
  createdById          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  flight               Flight?            @relation(fields: [flightId], references: [id], onDelete: SetNull)
  flightLeg            FlightLeg?         @relation(fields: [flightLegId], references: [id], onDelete: SetNull)
  operator             Operator           @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  operatingAuthority   OperatingAuthority @relation(fields: [operatingAuthorityId], references: [id], onDelete: Restrict)
  authorityRevision    AuthorityRevision  @relation(fields: [authorityRevisionId], references: [id], onDelete: Restrict)
  customer             Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy            User?              @relation("OperationalControlRecordCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  release              FlightRelease?
  releasePackages      ReleasePackage[]

  @@index([operatorId])
  @@index([operatingAuthorityId])
  @@index([authorityRevisionId])
  @@index([customerId])
}

model FlightRelease {
  id                         String                     @id @default(cuid())
  operationalControlRecordId String                     @unique
  status                     ReleaseStatus              @default(PLANNED)
  releasedById               String?
  releasedAt                 DateTime?
  releaseNotes               String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  operationalControlRecord   OperationalControlRecord   @relation(fields: [operationalControlRecordId], references: [id], onDelete: Restrict)
  releasedBy                 User?                      @relation("FlightReleaseReleasedBy", fields: [releasedById], references: [id], onDelete: SetNull)
  readinessSnapshots         ReleaseReadinessSnapshot[]
  releaseOverrides           ReleaseOverride[]
  releaseAuditEvents         ReleaseAuditEvent[]
  releasePackages            ReleasePackage[]

  @@index([operationalControlRecordId])
  @@index([status])
}

model User {
  id                            String                     @id @default(cuid())
  email                         String                     @unique
  role                          UserRole
  isActive                      Boolean                    @default(true)
  createdAt                     DateTime                   @default(now())
  updatedAt                     DateTime                   @updatedAt
  passwordCredential            UserPasswordCredential?
  sessions                      UserSession[]
  profile                       UserProfile?
  crewMember                    CrewMember?
  assignedCrewAssignments       AircraftCrewAssignment[]   @relation("AssignmentAuthor")
  timeOffRequestsSubmitted      TimeOffRequest[]           @relation("TimeOffRequestedBy")
  timeOffRequestsReviewed       TimeOffRequest[]           @relation("TimeOffReviewedBy")
  alertsCreated                 Alert[]                    @relation("AlertCreatedBy")
  alertsAcknowledged            Alert[]                    @relation("AlertAcknowledgedBy")
  alertsResolved                Alert[]                    @relation("AlertResolvedBy")
  operationalControlRecords     OperationalControlRecord[] @relation("OperationalControlRecordCreatedBy")
  flightReleases                FlightRelease[]            @relation("FlightReleaseReleasedBy")
  assignedAircraftAssignments   AircraftAssignment[]       @relation("AircraftAssignmentAssignedBy")
  assignedCrewLegAssignments    CrewLegAssignment[]        @relation("CrewLegAssignmentAssignedBy")
  lockedManifests               Manifest[]                 @relation("ManifestLockedBy")
  calculatedWeightBalanceRuns   WeightBalanceRun[]         @relation("WeightBalanceCalculatedBy")
  approvedWeightBalanceRuns     WeightBalanceRun[]         @relation("WeightBalanceApprovedBy")
  dispatchPackagesCreated       DispatchPackage[]          @relation("DispatchPackageCreatedBy")
  dispatchPackagesReviewed      DispatchPackage[]          @relation("DispatchPackageReviewedBy")
  reportedDiscrepancies         Discrepancy[]              @relation("DiscrepancyReportedBy")
  authorizedDeferrals           Deferral[]                 @relation("DeferralAuthorizedBy")
  approvedMaintenanceEvents     MaintenanceEvent[]         @relation("MaintenanceEventApprovedBy")
  airworthinessReleases         AirworthinessRelease[]     @relation("AirworthinessReleaseReleasedBy")
  evaluatedReleaseSnapshots     ReleaseReadinessSnapshot[] @relation("ReleaseReadinessSnapshotEvaluatedBy")
  authoredReleaseOverrides      ReleaseOverride[]          @relation("ReleaseOverrideActor")
  approvedReleaseOverrides      ReleaseOverride[]          @relation("ReleaseOverrideApprover")
  releaseAuditEvents            ReleaseAuditEvent[]        @relation("ReleaseAuditEventActor")
  releasePackagesCaptured       ReleasePackage[]           @relation("ReleasePackageCapturedBy")
  importBatchesCreated          ImportBatch[]              @relation("ImportBatchCreatedBy")
  importBatchesReviewed         ImportBatch[]              @relation("ImportBatchReviewedBy")
  importMappingDecisions        ImportMappingDecision[]    @relation("ImportMappingDecisionDecidedBy")
  crewSchedulePeriodsCreated    CrewSchedulePeriod[]       @relation("CrewSchedulePeriodCreatedBy")
  crewSchedulePeriodsPublished  CrewSchedulePeriod[]       @relation("CrewSchedulePeriodPublishedBy")
  crewScheduleRequestsSubmitted CrewScheduleRequest[]      @relation("CrewScheduleRequestSubmittedBy")
  crewScheduleRequestsReviewed  CrewScheduleRequest[]      @relation("CrewScheduleRequestReviewedBy")
  crewRotationPatternsCreated   CrewRotationPattern[]      @relation("CrewRotationPatternCreatedBy")
  crewScheduleEntriesCreated    CrewScheduleEntry[]        @relation("CrewScheduleEntryCreatedBy")
  crewScheduleEntriesPublished  CrewScheduleEntry[]        @relation("CrewScheduleEntryPublishedBy")
  crewCertificatesCreated       CrewCertificate[]          @relation("CrewCertificateCreatedBy")
  crewCertificatesVerified      CrewCertificate[]          @relation("CrewCertificateVerifiedBy")
  crewMedicalsCreated           CrewMedical[]              @relation("CrewMedicalCreatedBy")
  crewMedicalsVerified          CrewMedical[]              @relation("CrewMedicalVerifiedBy")
  crewTrainingEventsCreated     CrewTrainingEvent[]        @relation("CrewTrainingEventCreatedBy")
  crewTrainingEventsVerified    CrewTrainingEvent[]        @relation("CrewTrainingEventVerifiedBy")
  crewCheckEventsCreated        CrewCheckEvent[]           @relation("CrewCheckEventCreatedBy")
  crewCheckEventsVerified       CrewCheckEvent[]           @relation("CrewCheckEventVerifiedBy")
  crewPlannedComplianceEventsCreated CrewPlannedComplianceEvent[] @relation("CrewPlannedComplianceEventCreatedBy")
  crewRecencyEventsCreated      CrewRecencyEvent[]         @relation("CrewRecencyEventCreatedBy")
  crewRecencyEventsVerified     CrewRecencyEvent[]         @relation("CrewRecencyEventVerifiedBy")
  crewDutyPeriodsCreated        CrewDutyPeriod[]           @relation("CrewDutyPeriodCreatedBy")
  crewDutyPeriodsVerified       CrewDutyPeriod[]           @relation("CrewDutyPeriodVerifiedBy")
  crewRestPeriodsCreated        CrewRestPeriod[]           @relation("CrewRestPeriodCreatedBy")
  crewRestPeriodsVerified       CrewRestPeriod[]           @relation("CrewRestPeriodVerifiedBy")
  crewLocationRecordsCreated    CrewLocationRecord[]       @relation("CrewLocationRecordCreatedBy")
  crewLogisticsNeedsCreated     CrewLogisticsNeed[]        @relation("CrewLogisticsNeedCreatedBy")
  operatorFuelSettingsUpdated   OperatorFuelSetting[]      @relation("OperatorFuelSettingUpdatedBy")
  operatorReleaseSettingsUpdated OperatorReleaseSetting[]   @relation("OperatorReleaseSettingUpdatedBy")
  aircraftFuelEventsRecorded    AircraftFuelEvent[]        @relation("AircraftFuelEventRecordedBy")
  flightPreflightRecordsCompleted FlightPreflightRecord[]   @relation("FlightPreflightRecordCompletedBy")
  flightPostflightRecordsCompleted FlightPostflightRecord[] @relation("FlightPostflightRecordCompletedBy")
}

model OperatorFuelSetting {
  id                                  String   @id @default(cuid())
  operatorId                          String   @unique
  defaultJetAFuelDensityLbsPerGallon  Decimal  @default(6.700) @db.Decimal(6, 3)
  updatedById                         String?
  createdAt                           DateTime @default(now())
  updatedAt                           DateTime @updatedAt
  operator                            Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  updatedBy                           User?    @relation("OperatorFuelSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

model OperatorReleaseSetting {
  id                String               @id @default(cuid())
  operatorId        String               @unique
  dispatcherEnabled Boolean              @default(false)
  manifestMode      OperatorManifestMode @default(PREFLIGHT_VERIFY)
  updatedById       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  operator          Operator             @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  updatedBy         User?                @relation("OperatorReleaseSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

model UserPasswordCredential {
  id                    String   @id @default(cuid())
  userId                String   @unique
  passwordHash          String
  passwordHashAlgorithm String   @default("scrypt")
  mustChangePassword    Boolean  @default(false)
  lastChangedAt         DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lastChangedAt])
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String
  sessionTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model UserProfile {
  id                    String          @id @default(cuid())
  userId                String          @unique
  firstName             String
  lastName              String
  phone                 String?
  dateOfBirth           DateTime?
  idDocumentType        IdDocumentType?
  idDocumentNumber      String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Station {
  id                      String                   @id @default(cuid())
  code                    String                   @unique
  name                    String
  city                    String
  state                   String?
  country                 String                   @default("USA")
  timezone                String
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  aircraft                Aircraft[]
  crewMembers             CrewMember[]
  departures              Flight[]                 @relation("FlightDepartureStation")
  arrivals                Flight[]                 @relation("FlightArrivalStation")
  flightLegDepartures     FlightLeg[]              @relation("FlightLegDepartureStation")
  flightLegArrivals       FlightLeg[]              @relation("FlightLegArrivalStation")
  crewSchedules           CrewSchedule[]
  crewRotationPatternDays CrewRotationPatternDay[]
  crewScheduleEntries     CrewScheduleEntry[]
  crewLocationRecords     CrewLocationRecord[]
  logisticsNeedsFrom      CrewLogisticsNeed[]      @relation("CrewLogisticsNeedFromStation")
  logisticsNeedsTo        CrewLogisticsNeed[]      @relation("CrewLogisticsNeedToStation")
}

model Aircraft {
  id                    String                   @id @default(cuid())
  tailNumber            String                   @unique
  name                  String?
  type                  AircraftType
  status                AircraftStatus           @default(AVAILABLE)
  homeStationId         String?
  seats                 Int?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  homeStation           Station?                 @relation(fields: [homeStationId], references: [id], onDelete: SetNull)
  flights               Flight[]
  crewAssignments       AircraftCrewAssignment[]
  aircraftAssignments   AircraftAssignment[]
  alerts                Alert[]
  configurations        AircraftConfiguration[]
  capabilities          AircraftCapability[]
  discrepancies         Discrepancy[]
  deferrals             Deferral[]
  maintenanceEvents     MaintenanceEvent[]
  airworthinessReleases AirworthinessRelease[]
  crewLogisticsNeeds    CrewLogisticsNeed[]
  fuelEvents            AircraftFuelEvent[]

  @@index([status])
  @@index([type])
  @@index([homeStationId])
}

model AircraftConfiguration {
  id                 String                      @id @default(cuid())
  aircraftId         String
  configurationLabel String
  status             AircraftConfigurationStatus @default(ACTIVE)
  effectiveStart     DateTime                    @default(now())
  effectiveEnd       DateTime?
  passengerSeatCount Int?
  emptyWeight        Decimal?                    @db.Decimal(10, 2)
  emptyWeightCg      String?
  notes              String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  aircraft           Aircraft                    @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@unique([aircraftId, configurationLabel, effectiveStart])
  @@index([aircraftId, status])
  @@index([effectiveStart, effectiveEnd])
}

model AircraftCapability {
  id             String                   @id @default(cuid())
  aircraftId     String
  capabilityCode String
  status         AircraftCapabilityStatus @default(ACTIVE)
  effectiveStart DateTime                 @default(now())
  effectiveEnd   DateTime?
  description    String?
  notes          String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  aircraft       Aircraft                 @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@unique([aircraftId, capabilityCode, effectiveStart])
  @@index([aircraftId, status])
  @@index([capabilityCode])
}

model Flight {
