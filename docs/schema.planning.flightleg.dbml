// AeroOps Center planning DBML
// Last updated: 2026-06-08
// Scope: target data model direction. The initial FlightLeg foundation is now
// implemented additively. Release evidence, first airworthiness foundation,
// release-policy, and import-staging foundation tables are now implemented;
// deeper crew compliance, safety, and import-apply workflows remain
// planning-only.

Project AeroOps_Planning_FlightLeg {
  database_type: "PostgreSQL"
  Note: "Planning model for the final product direction. Do not treat as a migration-ready schema without a follow-up implementation plan."
}

Enum UserRole {
  ADMIN
  OPS
  DISPATCH
  MAINTENANCE
  CREW
  SAFETY
  VIEWER
}

Enum OperatingPart {
  PART_91
  PART_91K
  PART_135
}

Enum AuthorityStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  RETIRED
}

Enum FlightLegStatus {
  DRAFT
  SCHEDULED
  READY_FOR_RELEASE
  RELEASED
  ENROUTE
  COMPLETE
  CANCELLED
  DELAYED
}

Enum AssignmentStatus {
  PLANNED
  ACTIVE
  RELIEVED
  CANCELLED
}

Enum ReleaseStatus {
  PLANNED
  READY
  RELEASED
  AMENDED
  CANCELLED
  VOIDED
}

Enum ReleaseAuthorityClass {
  PART_91_BASELINE
  PART_91K_FRACTIONAL
  PART_135_ON_DEMAND
}

Enum ReleaseRuleSeverity {
  BLOCK
  WARN
  INFO
}

Enum ReleaseSnapshotStatus {
  PASS
  BLOCKED
  WARNING_ONLY
}

Enum ReleaseFindingStatus {
  PASS
  FAIL
  WARNING
  OVERRIDDEN
  NOT_APPLICABLE
}

Enum ReleaseOverrideDecision {
  APPROVED
  DENIED
  VOIDED
  SUPERSEDED
}

Enum ReleaseAuditEventType {
  READINESS_EVALUATED
  BLOCKER_FOUND
  OVERRIDE_APPROVED
  OVERRIDE_VOIDED
  RELEASE_BLOCKED
  RELEASE_COMPLETED
  RELEASE_CANCELLED
  RELEASE_VOIDED
}

Enum ReleasePackageStatus {
  DRAFT
  PREVIEW
  FINALIZED
  VOIDED
}

Enum ReleasePackageEvidenceType {
  OPERATIONAL_CONTROL_RECORD
  FLIGHT_RELEASE
  RELEASE_READINESS_SNAPSHOT
  RELEASE_AUDIT_EVENT
  MANIFEST
  MANIFEST_ITEM
  WEIGHT_BALANCE_RUN
  FLIGHT_LOCATING_RECORD
  POSITION_REPORT
  DISPATCH_PACKAGE
  WEATHER_BRIEFING
  NOTAM_SNAPSHOT
  FLIGHT_PLAN_REFERENCE
  AIRWORTHINESS_RELEASE
  AIRCRAFT_CONFIGURATION
  AIRCRAFT_CAPABILITY
  DISCREPANCY
  DEFERRAL
  MAINTENANCE_EVENT
  OTHER
}

Enum ImportDomain {
  AIRCRAFT_MAINTENANCE_AIRWORTHINESS
  FLIGHTLEG_HISTORY
  CREW_COMPLIANCE
  MANIFEST_HISTORY
  DISPATCH_RELEASE_EVIDENCE
}

Enum ImportBatchStatus {
  DRAFT
  STAGED
  VALIDATED
  REVIEW_READY
  APPROVED
  REJECTED
  APPLIED
  VOIDED
}

Enum ImportSourceType {
  CSV
  XLSX
  JSON
  PDF_REFERENCE
  MANUAL_REFERENCE
  OTHER
}

Enum ImportValidationStatus {
  PENDING
  ACCEPTED
  WARNING
  REJECTED
  DUPLICATE
}

Enum ImportFindingSeverity {
  INFO
  WARN
  ERROR
}

Enum ImportMappingDecisionStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  SUPERSEDED
}

Enum ManifestStatus {
  DRAFT
  READY
  LOCKED
  AMENDED
  VOIDED
}

Enum FlightLocatingStatus {
  NOT_STARTED
  FILED
  ACTIVE
  CLOSED
  OVERDUE
}

Enum DispatchPackageStatus {
  DRAFT
  READY
  REVIEWED
  VOIDED
}

Enum AircraftStatus {
  AVAILABLE
  RESERVED
  IN_FLIGHT
  IN_MAINTENANCE
  OUT_OF_SERVICE
}

Enum MaintenanceRecordStatus {
  OPEN
  DEFERRED
  CLEARED
  CLOSED
}

Enum CrewEmploymentStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

Enum CrewDutyStatus {
  ON_DUTY
  RESERVE
  OFF_DUTY
  VACATION
  SICK
  TRAINING
  DEADHEADING
}

Enum SeatRole {
  CPT
  FO
  FA
  CA
}

Enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

Enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

Enum SafetyReportStatus {
  SUBMITTED
  TRIAGED
  INVESTIGATING
  MITIGATING
  CLOSED
}

// Core people, organization, and authority.

Table User {
  id varchar [pk]
  email varchar [not null, unique]
  role UserRole [not null]
  isActive boolean [not null, default: true]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table UserPasswordCredential {
  id varchar [pk]
  userId varchar [not null, unique]
  passwordHash varchar [not null]
  passwordHashAlgorithm varchar [not null, default: "scrypt"]
  mustChangePassword boolean [not null, default: false]
  lastChangedAt timestamp [not null]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table UserSession {
  id varchar [pk]
  userId varchar [not null]
  sessionTokenHash varchar [not null, unique]
  expiresAt timestamp [not null]
  revokedAt timestamp
  userAgent varchar
  ipAddress varchar
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    userId
    expiresAt
    revokedAt
  }
}

Table UserProfile {
  id varchar [pk]
  userId varchar [not null, unique]
  firstName varchar [not null]
  lastName varchar [not null]
  phone varchar
  dateOfBirth timestamp
  emergencyContactName varchar
  emergencyContactPhone varchar
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table Operator {
  id varchar [pk]
  name varchar [not null]
  code varchar [not null, unique]
  certificateNumber varchar
  isActive boolean [not null, default: true]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table OperatingAuthority {
  id varchar [pk]
  operatorId varchar [not null]
  operatingPart OperatingPart [not null]
  displayName varchar [not null]
  status AuthorityStatus [not null]
  effectiveStart timestamp
  effectiveEnd timestamp
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (operatorId, operatingPart)
    (operatorId, status)
  }
}

Table AuthorityRevision {
  id varchar [pk]
  operatingAuthorityId varchar [not null]
  revisionLabel varchar [not null]
  effectiveStart timestamp [not null]
  effectiveEnd timestamp
  status AuthorityStatus [not null]
  notes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (operatingAuthorityId, revisionLabel) [unique]
    (operatingAuthorityId, status)
  }
}

Table Manual {
  id varchar [pk]
  operatingAuthorityId varchar [not null]
  name varchar [not null]
  documentIdentifier varchar
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table ManualRevision {
  id varchar [pk]
  manualId varchar [not null]
  revisionLabel varchar [not null]
  revisionDate timestamp [not null]
  effectiveStart timestamp
  effectiveEnd timestamp
  storageObjectKey varchar
  notes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

// Geography and fleet.

Table Station {
  id varchar [pk]
  code varchar [not null, unique]
  name varchar [not null]
  city varchar [not null]
  state varchar
  country varchar [not null]
  timezone varchar [not null]
  isActive boolean [not null, default: true]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table AircraftType {
  id varchar [pk]
  code varchar [not null, unique]
  manufacturer varchar
  model varchar [not null]
  typeDesignator varchar
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table Aircraft {
  id varchar [pk]
  aircraftTypeId varchar [not null]
  tailNumber varchar [not null, unique]
  serialNumber varchar
  name varchar
  status AircraftStatus [not null]
  homeStationId varchar
  defaultSeatCount int
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table AircraftConfiguration {
  id varchar [pk]
  aircraftId varchar [not null]
  name varchar [not null]
  passengerSeatCount int
  maxRampWeight decimal
  maxTakeoffWeight decimal
  maxLandingWeight decimal
  effectiveStart timestamp [not null]
  effectiveEnd timestamp
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table AircraftCapability {
  id varchar [pk]
  aircraftId varchar [not null]
  capabilityCode varchar [not null]
  description text
  effectiveStart timestamp [not null]
  effectiveEnd timestamp
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (aircraftId, capabilityCode)
  }
}

// Trip and leg anchor.

Table TripOrMission {
  id varchar [pk]
  operatorId varchar [not null]
  tripNumber varchar [not null]
  customerName varchar
  missionType varchar
  requestedStart timestamp
  requestedEnd timestamp
  notes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (operatorId, tripNumber) [unique]
  }
}

Table FlightLeg {
  id varchar [pk]
  legacyFlightId varchar [unique, note: "Temporary bridge to current Flight rows during read migration."]
  tripOrMissionId varchar
  operatorId varchar [not null]
  operatingAuthorityId varchar [not null]
  authorityRevisionId varchar [not null]
  legNumber int
  flightNumber varchar
  departureStationId varchar [not null]
  arrivalStationId varchar [not null]
  scheduledDeparture timestamp [not null]
  scheduledArrival timestamp [not null]
  actualDeparture timestamp
  actualArrival timestamp
  status FlightLegStatus [not null]
  notes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (operatorId, flightNumber, scheduledDeparture)
    (status, scheduledDeparture)
    (departureStationId, scheduledDeparture)
    (arrivalStationId, scheduledArrival)
  }
}

Table TurnaroundLink {
  id varchar [pk]
  inboundFlightLegId varchar [not null]
  outboundFlightLegId varchar [not null]
  minimumTurnMinutes int
  notes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (inboundFlightLegId, outboundFlightLegId) [unique]
  }
}

Table AircraftAssignment {
  id varchar [pk]
  flightLegId varchar [not null]
  aircraftId varchar [not null]
  configurationId varchar
  status AssignmentStatus [not null]
  assignedAt timestamp [not null]
  releasedAt timestamp
  assignedById varchar
  notes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (flightLegId, aircraftId) [unique]
    (aircraftId, assignedAt)
  }
}

// Crew, assignment, duty, and qualification.

Table CrewMember {
  id varchar [pk]
  userId varchar [unique]
  employeeNumber varchar [not null, unique]
  firstName varchar [not null]
  lastName varchar [not null]
  baseStationId varchar [not null]
  employmentStatus CrewEmploymentStatus [not null]
  dutyStatus CrewDutyStatus [not null]
  hireDate timestamp
  phone varchar
  email varchar
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table CrewLegAssignment {
  id varchar [pk]
  flightLegId varchar [not null]
  crewMemberId varchar [not null]
  seatRole SeatRole [not null]
  status AssignmentStatus [not null]
  reportTime timestamp
  releaseTime timestamp
  assignedById varchar
  sourceAircraftCrewAssignmentId varchar
  notes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (flightLegId, seatRole)
    (crewMemberId, reportTime)
  }
}

Table CrewAircraftBlockAssignment {
  id varchar [pk]
  aircraftId varchar [not null]
  crewMemberId varchar [not null]
  seatRole SeatRole [not null]
  startsAt timestamp [not null]
  endsAt timestamp
  isActive boolean [not null, default: true]
  assignedById varchar
  notes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table CrewCertificate {
  id varchar [pk]
  crewMemberId varchar [not null]
  certificateType varchar [not null]
  certificateNumber varchar
  ratingOrEndorsement varchar
  aircraftType varchar
  seatRole SeatRole
  issuingAuthority varchar
  issuedAt timestamp
  expiresAt timestamp
  status varchar [not null]
  createdById varchar
  verifiedById varchar
  verifiedAt timestamp
  notes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table CrewMedical {
  id varchar [pk]
  crewMemberId varchar [not null]
  medicalClass varchar [not null]
  issuedAt timestamp
  expiresAt timestamp
  limitations text
  status varchar [not null]
  createdById varchar
  verifiedById varchar
  verifiedAt timestamp
  notes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table CrewTrainingEvent {
  id varchar [pk]
  crewMemberId varchar [not null]
  trainingType varchar [not null]
  programName varchar [not null]
  moduleName varchar
  aircraftType varchar
  completedAt timestamp [not null]
  expiresAt timestamp
  result varchar [not null]
  instructorName varchar
  providerName varchar
  status varchar [not null]
  createdById varchar
  verifiedById varchar
  verifiedAt timestamp
  notes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table CrewCheckEvent {
  id varchar [pk]
  crewMemberId varchar [not null]
  checkType varchar [not null]
  aircraftType varchar
  seatRole SeatRole
  completedAt timestamp [not null]
  expiresAt timestamp
  result varchar [not null]
  evaluatorName varchar
  providerName varchar
  status varchar [not null]
  createdById varchar
  verifiedById varchar
  verifiedAt timestamp
  notes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table CrewRecencyEvent {
  id varchar [pk]
  crewMemberId varchar [not null]
  recencyType varchar [not null]
  aircraftType varchar
  seatRole SeatRole
  eventAt timestamp [not null]
  quantity int
  windowStart timestamp
  windowEnd timestamp
  result varchar [not null]
  status varchar [not null]
  createdById varchar
  verifiedById varchar
  verifiedAt timestamp
  notes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table CrewDutyPeriod {
  id varchar [pk]
  crewMemberId varchar [not null]
  startsAt timestamp [not null]
  endsAt timestamp
  status varchar [not null]
  dutyStatus CrewDutyStatus [not null]
  source varchar
  createdById varchar
  verifiedById varchar
  verifiedAt timestamp
  notes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table CrewRestPeriod {
  id varchar [pk]
  crewMemberId varchar [not null]
  startsAt timestamp [not null]
  endsAt timestamp
  status varchar [not null]
  source varchar
  createdById varchar
  verifiedById varchar
  verifiedAt timestamp
  notes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

// Operational control, release, and dispatch package.

Table OperationalControlRecord {
  id varchar [pk]
  flightLegId varchar [not null, unique]
  operatorId varchar [not null]
  operatingAuthorityId varchar [not null]
  authorityRevisionId varchar [not null]
  controllingEntity varchar [not null]
  operationalControlPersonId varchar
  controlNotes text
  createdById varchar
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table ReleasePackage {
  id varchar [pk]
  flightLegId varchar [not null]
  operationalControlRecordId varchar [not null]
  flightReleaseId varchar [not null]
  readinessSnapshotId varchar
  packageNumber varchar [not null, unique]
  status ReleasePackageStatus [not null]
  capturedAt timestamp [not null]
  finalizedAt timestamp
  voidedAt timestamp
  capturedById varchar
  summary json
  notes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table ReleasePackageEvidenceLink {
  id varchar [pk]
  releasePackageId varchar [not null]
  evidenceType ReleasePackageEvidenceType [not null]
  evidenceId varchar
  evidenceLabel varchar [not null]
  statusLabel varchar
  isRequired boolean [not null]
  summary json
  capturedMetadata json
  createdAt timestamp [not null]
}

Table ReleasePolicyProfile {
  id varchar [pk]
  profileKey varchar [not null, unique]
  operatorId varchar [not null]
  operatingAuthorityId varchar
  name varchar [not null]
  authorityClass ReleaseAuthorityClass [not null]
  isDefault boolean [not null]
  effectiveFrom timestamp [not null]
  effectiveTo timestamp
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table ReleasePolicyRule {
  id varchar [pk]
  profileId varchar [not null]
  ruleKey varchar [not null]
  readinessCategory varchar [not null]
  severity ReleaseRuleSeverity [not null]
  isOverridable boolean [not null]
  requiresSecondApproval boolean [not null]
  manualEvidenceAllowed boolean [not null]
  providerEvidenceRequired boolean [not null]
  effectiveFrom timestamp [not null]
  effectiveTo timestamp
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table ReleaseReadinessSnapshot {
  id varchar [pk]
  flightLegId varchar [not null]
  flightReleaseId varchar [not null]
  policyProfileId varchar [not null]
  snapshotStatus ReleaseSnapshotStatus [not null]
  evaluatedAt timestamp [not null]
  evaluatedById varchar
  authorityClass ReleaseAuthorityClass [not null]
  summary jsonb
  createdAt timestamp [not null]
}

Table ReleaseReadinessFinding {
  id varchar [pk]
  snapshotId varchar [not null]
  ruleId varchar
  ruleKey varchar [not null]
  readinessCategory varchar [not null]
  severity ReleaseRuleSeverity [not null]
  status ReleaseFindingStatus [not null]
  isOverridable boolean [not null]
  summary text [not null]
  evidenceRefType varchar
  evidenceRefId varchar
  details jsonb
  createdAt timestamp [not null]
}

Table ReleaseOverride {
  id varchar [pk]
  findingId varchar [not null]
  flightLegId varchar [not null]
  flightReleaseId varchar [not null]
  policyProfileId varchar [not null]
  decision ReleaseOverrideDecision [not null]
  reason text [not null]
  supportingReference text
  actorUserId varchar
  actorRole varchar
  approvedById varchar
  approvedRole varchar
  attestationText text
  signatureRef varchar
  expiresAt timestamp
  createdAt timestamp [not null]
  voidedAt timestamp
  voidReason text
}

Table ReleaseAuditEvent {
  id varchar [pk]
  flightLegId varchar [not null]
  flightReleaseId varchar
  snapshotId varchar
  overrideId varchar
  eventType ReleaseAuditEventType [not null]
  actorUserId varchar
  actorRole varchar
  message text [not null]
  metadata jsonb
  createdAt timestamp [not null]
}

// Legacy import staging. These tables are implemented as a staging foundation.
// Parser/upload/apply workflows and operational target writes remain deferred.

Table ImportBatch {
  id varchar [pk]
  importDomain ImportDomain [not null]
  status ImportBatchStatus [not null, default: "DRAFT"]
  sourceSystem varchar
  batchKey varchar [unique]
  summary jsonb
  notes text
  createdById varchar
  reviewedById varchar
  reviewedAt timestamp
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table ImportSource {
  id varchar [pk]
  batchId varchar [not null]
  sourceName varchar [not null]
  sourceType ImportSourceType [not null]
  sourceHash varchar
  notes text
  createdAt timestamp [not null]
}

Table ImportStagingRow {
  id varchar [pk]
  batchId varchar [not null]
  sourceId varchar
  sourceRowNumber int
  sourceExternalId varchar
  idempotencyKey varchar [not null, unique]
  rawRow jsonb [not null]
  mappedTargetType varchar
  mappedTargetKey varchar
  validationStatus ImportValidationStatus [not null, default: "PENDING"]
  validationSummary jsonb
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table ImportValidationFinding {
  id varchar [pk]
  stagingRowId varchar [not null]
  severity ImportFindingSeverity [not null]
  code varchar [not null]
  message text [not null]
  fieldName varchar
  details jsonb
  createdAt timestamp [not null]
}

Table ImportMappingDecision {
  id varchar [pk]
  stagingRowId varchar [not null]
  decision ImportMappingDecisionStatus [not null, default: "PROPOSED"]
  targetType varchar [not null]
  targetId varchar
  reason text
  decidedById varchar
  decidedAt timestamp
  createdAt timestamp [not null]
}

Table DispatchPackage {
  id varchar [pk]
  flightLegId varchar [not null, unique]
  releasePackageId varchar
  weatherBriefingId varchar
  notamSnapshotId varchar
  flightPlanReferenceId varchar
  status DispatchPackageStatus [not null, default: "DRAFT"]
  readyAt timestamp
  reviewedAt timestamp
  reviewedById varchar
  voidedAt timestamp
  reviewNotes text
  performanceData jsonb
  createdById varchar
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table WeatherBriefingSnapshot {
  id varchar [pk]
  provider varchar
  briefingAt timestamp [not null]
  routeSummary text
  rawSnapshot jsonb
  createdAt timestamp [not null]
}

Table NotamSnapshot {
  id varchar [pk]
  capturedAt timestamp [not null]
  affectedStationCodes text
  rawSnapshot jsonb
  createdAt timestamp [not null]
}

Table FlightPlanReference {
  id varchar [pk]
  flightLegId varchar [not null]
  provider varchar
  externalReference varchar
  filedAt timestamp
  status varchar
  routeText text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

// Manifest, weight and balance, and locating.

Table Passenger {
  id varchar [pk]
  firstName varchar [not null]
  lastName varchar [not null]
  dateOfBirth timestamp
  email varchar
  phone varchar
  idDocumentNumber varchar
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table Manifest {
  id varchar [pk]
  flightLegId varchar [not null, unique]
  status ManifestStatus [not null]
  lockedAt timestamp
  lockedById varchar
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table ManifestItem {
  id varchar [pk]
  manifestId varchar [not null]
  passengerId varchar
  personName varchar
  seatNumber varchar
  weight decimal
  baggageWeight decimal
  checkedInAt timestamp
  boardedAt timestamp
  notes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table WeightBalanceRun {
  id varchar [pk]
  flightLegId varchar [not null]
  manifestId varchar
  aircraftConfigurationId varchar
  status varchar [not null]
  takeoffWeight decimal
  landingWeight decimal
  centerOfGravity varchar
  calculatedById varchar
  calculatedAt timestamp
  approvedById varchar
  approvedAt timestamp
  calculationSnapshot jsonb
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table FlightLocatingRecord {
  id varchar [pk]
  flightLegId varchar [not null, unique]
  status FlightLocatingStatus [not null]
  responsibleParty varchar
  plannedRoute text
  lastKnownPosition varchar
  activatedAt timestamp
  closedAt timestamp
  overdueAt timestamp
  notes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table PositionReport {
  id varchar [pk]
  flightLocatingRecordId varchar [not null]
  reportedAt timestamp [not null]
  positionSummary text [not null]
  latitude decimal
  longitude decimal
  altitude int
  groundspeed int
  heading int
  source varchar [not null]
  notes text
  createdAt timestamp [not null]
}

// Maintenance and airworthiness.

Table Discrepancy {
  id varchar [pk]
  aircraftId varchar [not null]
  reportedById varchar
  discrepancyNumber varchar [not null]
  title varchar [not null]
  description text
  status varchar [not null]
  severity varchar
  reportedAt timestamp [not null]
  clearedAt timestamp
  correctiveSummary text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table Deferral {
  id varchar [pk]
  aircraftId varchar [not null]
  discrepancyId varchar [not null]
  authorizedById varchar
  deferralNumber varchar [not null]
  status varchar [not null]
  category varchar
  deferredAt timestamp [not null]
  dueAt timestamp
  clearedAt timestamp
  notes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table MaintenanceEvent {
  id varchar [pk]
  aircraftId varchar [not null]
  discrepancyId varchar
  approvedById varchar
  maintenanceNumber varchar [not null]
  eventType varchar [not null]
  status varchar [not null]
  scheduledAt timestamp
  startedAt timestamp
  completedAt timestamp
  providerName varchar
  description text
  returnToServiceAt timestamp
  notes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table AirworthinessRelease {
  id varchar [pk]
  aircraftId varchar [not null]
  flightLegId varchar
  releasedById varchar
  releaseNumber varchar [not null]
  status varchar [not null]
  releasedAt timestamp
  expiresAt timestamp
  releaseNotes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

// Alerts and safety.

Table Alert {
  id varchar [pk]
  type varchar [not null]
  severity AlertSeverity [not null]
  status AlertStatus [not null]
  title varchar [not null]
  message text [not null]
  flightLegId varchar
  aircraftId varchar
  crewMemberId varchar
  createdById varchar
  acknowledgedById varchar
  resolvedById varchar
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table SafetyReport {
  id varchar [pk]
  reporterId varchar
  flightLegId varchar
  aircraftId varchar
  category varchar [not null]
  status SafetyReportStatus [not null]
  title varchar [not null]
  narrative text [not null]
  submittedAt timestamp [not null]
  closedAt timestamp
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table Hazard {
  id varchar [pk]
  safetyReportId varchar
  title varchar [not null]
  description text
  severity varchar
  likelihood varchar
  riskLevel varchar
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table CorrectiveAction {
  id varchar [pk]
  safetyReportId varchar
  hazardId varchar
  ownerId varchar
  title varchar [not null]
  dueAt timestamp
  completedAt timestamp
  status varchar [not null]
  notes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

