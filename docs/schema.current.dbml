  centerOfGravity varchar
  calculatedById varchar
  calculatedAt timestamp
  approvedById varchar
  approvedAt timestamp
  calculationSnapshot jsonb
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (flightLegId, runLabel) [unique]
    (flightLegId, status)
    manifestId
    calculatedById
    approvedById
  }
}

Table FlightLocatingRecord {
  id varchar [pk]
  flightLegId varchar [not null, unique]
  status FlightLocatingStatus [not null, default: "NOT_STARTED"]
  responsibleParty varchar
  plannedRoute text
  lastKnownPosition varchar
  activatedAt timestamp
  closedAt timestamp
  overdueAt timestamp
  notes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    status
  }
}

Table PositionReport {
  id varchar [pk]
  flightLocatingRecordId varchar [not null]
  reportedAt timestamp [not null]
  positionSummary text [not null]
  latitude decimal
  longitude decimal
  altitude int
  groundspeed int
  heading int
  source varchar [not null, default: "MANUAL"]
  notes text
  createdAt timestamp [not null]

  indexes {
    (flightLocatingRecordId, reportedAt)
    source
  }
}

Table WeatherBriefingSnapshot {
  id varchar [pk]
  snapshotKey varchar [not null, unique]
  provider varchar
  briefingAt timestamp [not null]
  routeSummary text
  rawSnapshot jsonb
  createdAt timestamp [not null]
}

Table NotamSnapshot {
  id varchar [pk]
  snapshotKey varchar [not null, unique]
  capturedAt timestamp [not null]
  affectedStationCodes text
  rawSnapshot jsonb
  createdAt timestamp [not null]
}

Table FlightPlanReference {
  id varchar [pk]
  flightLegId varchar [not null]
  provider varchar
  externalReference varchar
  filedAt timestamp
  status varchar
  routeText text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (flightLegId, externalReference) [unique]
    flightLegId
    status
  }
}

Table DispatchPackage {
  id varchar [pk]
  flightLegId varchar [not null, unique]
  weatherBriefingId varchar
  notamSnapshotId varchar
  flightPlanReferenceId varchar
  status DispatchPackageStatus [not null, default: "DRAFT"]
  readyAt timestamp
  reviewedAt timestamp
  reviewedById varchar
  voidedAt timestamp
  reviewNotes text
  performanceData jsonb
  createdById varchar
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    weatherBriefingId
    notamSnapshotId
    flightPlanReferenceId
    status
    reviewedById
    createdById
  }
}

Table CrewMember {
  id varchar [pk]
  userId varchar [unique]
  employeeNumber varchar [not null, unique]
  firstName varchar [not null]
  lastName varchar [not null]
  baseStationId varchar [not null]
  employmentStatus EmploymentStatus [not null, default: "ACTIVE"]
  dutyStatus DutyStatus [not null, default: "OFF_DUTY"]
  hireDate timestamp
  phone varchar
  email varchar
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    baseStationId
    employmentStatus
    dutyStatus
  }
}

Table CrewQualification {
  id varchar [pk]
  crewMemberId varchar [not null]
  aircraftType AircraftType [not null]
  seatRole SeatRole [not null]
  issuedAt timestamp [not null]
  expiresAt timestamp
  notes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (crewMemberId, aircraftType, seatRole) [unique]
    (crewMemberId, expiresAt)
    (aircraftType, seatRole)
  }
}

Table AircraftCrewAssignment {
  id varchar [pk]
  aircraftId varchar [not null]
  crewMemberId varchar [not null]
  seatRole SeatRole [not null]
  startsAt timestamp [not null]
  endsAt timestamp
  isActive boolean [not null, default: true]
  assignedById varchar
  notes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (aircraftId, crewMemberId, seatRole, startsAt) [unique]
    (aircraftId, startsAt, endsAt)
    (aircraftId, seatRole, startsAt)
    (crewMemberId, startsAt)
    isActive
  }
}

Table CrewSchedule {
  id varchar [pk]
  crewMemberId varchar [not null]
  stationId varchar
  date timestamp [not null]
  dutyStatus DutyStatus [not null]
  startsAt timestamp
  endsAt timestamp
  notes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (crewMemberId, date)
    date
  }
}

Table CrewSchedulePeriod {
  id varchar [pk]
  periodKey varchar [not null, unique]
  name varchar [not null]
  status CrewSchedulePeriodStatus [not null, default: "BID_OPEN"]
  startsAt timestamp [not null]
  endsAt timestamp [not null]
  bidOpenAt timestamp
  bidCloseAt timestamp
  publishedAt timestamp
  archivedAt timestamp
  createdById varchar
  publishedById varchar
  notes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (status, startsAt)
    (startsAt, endsAt)
    createdById
    publishedById
  }
}

Table CrewScheduleRequest {
  id varchar [pk]
  periodId varchar [not null]
  crewMemberId varchar [not null]
  requestType CrewScheduleRequestType [not null]
  status CrewScheduleRequestStatus [not null, default: "SUBMITTED"]
  startDate timestamp
  endDate timestamp
  preferredDutyStatus DutyStatus
  requestedPatternId varchar
  requestedSwapCrewMemberId varchar
  submittedById varchar
  reviewedById varchar
  reviewedAt timestamp
  requestNotes text
  reviewNotes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (periodId, status)
    (crewMemberId, createdAt)
    (requestType, status)
    (startDate, endDate)
    requestedPatternId
    requestedSwapCrewMemberId
    submittedById
    reviewedById
  }
}

Table CrewRotationPattern {
  id varchar [pk]
  patternKey varchar [not null, unique]
  name varchar [not null]
  description text
  cycleLengthDays int [not null]
  isActive boolean [not null, default: true]
  createdById varchar
  notes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    isActive
    createdById
  }
}

Table CrewRotationPatternDay {
  id varchar [pk]
  patternId varchar [not null]
  dayNumber int [not null]
  dutyStatus DutyStatus [not null]
  stationId varchar
  startsAtMinutes int
  endsAtMinutes int
  notes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (patternId, dayNumber) [unique]
    patternId
    stationId
  }
}

Table CrewScheduleEntry {
  id varchar [pk]
  periodId varchar [not null]
  crewMemberId varchar [not null]
  stationId varchar
  sourceRequestId varchar
  rotationPatternId varchar
  generatedCrewScheduleId varchar
  status CrewScheduleEntryStatus [not null, default: "DRAFT"]
  date timestamp [not null]
  dutyStatus DutyStatus [not null]
  startsAt timestamp
  endsAt timestamp
  publishedAt timestamp
  createdById varchar
  publishedById varchar
  notes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (periodId, crewMemberId, date, dutyStatus) [unique]
    (periodId, status)
    (crewMemberId, date)
    (date, status)
    stationId
    sourceRequestId
    rotationPatternId
    generatedCrewScheduleId
    createdById
    publishedById
  }
}

Table CrewFlightLog {
  id varchar [pk]
  crewMemberId varchar [not null]
  flightId varchar [not null]
  seatRole SeatRole [not null]
  reportTime timestamp
  releaseTime timestamp
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (crewMemberId, flightId, seatRole) [unique]
    flightId
  }
}

Table Passenger {
  id varchar [pk]
  firstName varchar [not null]
  lastName varchar [not null]
  dateOfBirth timestamp
  email varchar
  phone varchar
  idDocumentType IdDocumentType
  idDocumentNumber varchar
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (lastName, firstName)
  }
}

Table FlightPassenger {
  id varchar [pk]
  flightId varchar [not null]
  passengerId varchar [not null]
  seatNumber varchar
  checkedInAt timestamp
  boardedAt timestamp
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (flightId, passengerId) [unique]
    (flightId, seatNumber)
  }
}

Table TimeOffRequest {
  id varchar [pk]
  crewMemberId varchar [not null]
  requestType TimeOffRequestType [not null]
  status TimeOffRequestStatus [not null, default: "PENDING"]
  startDate timestamp [not null]
  endDate timestamp [not null]
  reason text
  requestedById varchar
  reviewedById varchar
  reviewedAt timestamp
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (crewMemberId, startDate)
    (status, createdAt)
  }
}

Table Alert {
  id varchar [pk]
  type AlertType [not null]
  severity AlertSeverity [not null, default: "MEDIUM"]
  status AlertStatus [not null, default: "ACTIVE"]
  title varchar [not null]
  message text [not null]
  flightId varchar
  aircraftId varchar
  crewMemberId varchar
  createdById varchar
  acknowledgedById varchar
  resolvedById varchar
  acknowledgedAt timestamp
  resolvedAt timestamp
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (status, type, createdAt)
    createdAt
  }
}

Table DutyRule {
  id varchar [pk]
  name varchar [not null, unique]
  description text
  maxDutyHours int
  minRestHours int
  maxFlightHoursPerDay int
  maxConsecutiveDays int
  isActive boolean [not null, default: true]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    isActive
  }
}

