  attestationText text
  signatureRef varchar
  expiresAt timestamp
  createdAt timestamp [not null]
  voidedAt timestamp
  voidReason text

  indexes {
    findingId
    (flightLegId, createdAt)
    flightReleaseId
    policyProfileId
    decision
    actorUserId
    approvedById
  }
}

