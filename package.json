    "smoke:crew-logistics-workbench": "tsx scripts/smoke-crew-logistics-workbench.ts",
    "smoke:crew-coverage-eligibility": "tsx scripts/smoke-crew-coverage-eligibility.ts",
    "smoke:crew-core-fit": "tsx scripts/smoke-crew-core-fit.ts",
    "smoke:crew-compliance-evaluator": "tsx scripts/smoke-crew-compliance-evaluator.ts",
    "smoke:crew-scheduling-workbench": "tsx scripts/smoke-crew-scheduling-workbench.ts",
    "smoke:release-workflow-phases": "tsx scripts/smoke-release-workflow-phases.ts",
    "smoke:customer-passenger-manifest": "tsx scripts/smoke-customer-passenger-manifest.ts",
    "smoke:passenger-identity-documents": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-tsx.ps1 scripts/smoke-passenger-identity-documents.ts",
    "smoke:aircraft-logbook": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-tsx.ps1 scripts/smoke-aircraft-logbook.ts",
    "smoke:maintenance-lifecycle": "tsx scripts/smoke-simplified-maintenance-lifecycle.ts",
    "smoke:maintenance-logbook-drawer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-tsx.ps1 scripts/smoke-maintenance-logbook-drawer.ts",
    "smoke:fuel-workflow": "tsx scripts/smoke-fuel-workflow.ts",
    "smoke:browser": "playwright test",
    "playwright:install": "playwright install chromium",
    "db:local:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-docker-compose.ps1 up -Detach postgres",
    "db:local:down": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-docker-compose.ps1 down",
    "db:local:migrate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-prisma.ps1 migrate deploy",
    "db:local:seed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-prisma.ps1 db seed",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
