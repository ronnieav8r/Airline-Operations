{
  "name": "aeroops-center",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "next dev -H 127.0.0.1 -p 3200",
    "build": "next build",
    "start": "next start",
    "render-build": "prisma migrate deploy && prisma generate && npm run backfill:authority && npm run backfill:flightleg && npm run backfill:release-evidence && npm run backfill:airworthiness && npm run backfill:release-policy && npm run backfill:crew-compliance-rules && npm run backfill:crew-compliance && npm run backfill:duty-rest-policy && npm run backfill:fuel && next build",
    "backfill:authority": "tsx scripts/backfill-authority-demo.ts",
    "backfill:flightleg": "tsx scripts/backfill-flightleg-demo.ts",
    "backfill:release-evidence": "tsx scripts/backfill-release-evidence-demo.ts",
    "backfill:airworthiness": "tsx scripts/backfill-airworthiness-demo.ts",
    "backfill:release-policy": "tsx scripts/backfill-release-policy-demo.ts",
    "backfill:crew-compliance-rules": "tsx scripts/backfill-crew-compliance-rules.ts",
    "backfill:crew-compliance": "tsx scripts/backfill-crew-compliance-demo.ts",
    "backfill:duty-rest-policy": "tsx scripts/backfill-duty-rest-policy-demo.ts",
    "backfill:fuel": "tsx scripts/backfill-fuel-demo.ts",
    "seed:duty-rest-scenarios": "tsx scripts/seed-duty-rest-scenarios.ts",
    "seed:scheduling-demo-pilots": "tsx scripts/seed-scheduling-demo-pilots.ts",
    "seed:aircraft-coverage-demo": "tsx scripts/seed-aircraft-coverage-demo.ts",
    "seed:aircraft-logbook-demo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-tsx.ps1 scripts/seed-aircraft-logbook-demo.ts",
    "seed:crew-me-demo": "tsx scripts/seed-crew-me-demo.ts",
    "seed:maintenance-program-demo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-tsx.ps1 scripts/seed-maintenance-program-demo.ts",
    "seed:ops-month": "tsx scripts/seed-ops-month-demo.ts",
    "test:users:setup": "tsx scripts/setup-smoke-users.ts",
    "smoke:app": "tsx scripts/smoke-app.ts",
    "smoke:workflows": "tsx scripts/smoke-workflows.ts",
    "smoke:duty-rest-snapshot": "tsx scripts/smoke-duty-rest-snapshot.ts",
    "smoke:schedule-publishing": "tsx scripts/smoke-schedule-publishing.ts",
    "smoke:rotation-patterns": "tsx scripts/smoke-rotation-patterns.ts",
    "smoke:reusable-templates": "tsx scripts/smoke-reusable-templates.ts",
    "smoke:crew-requests-time-off": "tsx scripts/smoke-crew-requests-time-off.ts",
